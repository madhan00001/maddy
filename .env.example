# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000

# LLM Provider & Model
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Embedding Provider & Model
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Document Chunking & Retrieval Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Vector Database Path & Relational Database URL
VECTOR_DB_PATH=./vector_db
DATABASE_URL=sqlite:///./chatbot.db

# Authentication / Security Secret
JWT_SECRET=change-this-to-a-random-secret-key

# Frontend only: leave empty for same-origin/local development; set on Vercel to the backend origin.
VITE_API_BASE_URL=

# Backend only: exact Vercel frontend origin (no trailing slash).
FRONTEND_URL=
